# ~/.config/systemd/user/agentkb-sync.timer
#   systemctl --user enable --now agentkb-sync.timer
# Secret değerleri bu bilgisayardan çıkmaz; anlık görüntüye girmez ve senkronlanmaz (ADR-0015).

[Unit]
Description=agentkb anlık görüntü ve senkronu 10 dakikada bir

[Timer]
# OnBootSec değil: kullanıcı yöneticisi ilk girişte açılır; açılış süresi geçmişse timer hemen tetiklenir ve
# henüz dinlemeyen sunucuya gider (çıkış 3). OnStartupSec kullanıcı yöneticisinin açılışından sayar.
OnStartupSec=5min
OnUnitActiveSec=10min
# Persistent= yalnız OnCalendar= ile etkilidir (systemd.timer(5)); burada işe yaramadığı için yok.

[Install]
WantedBy=timers.target
