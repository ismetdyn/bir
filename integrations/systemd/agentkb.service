# ~/.config/systemd/user/agentkb.service
# Şablon: integrations/install.sh @JAVA@ yerine sürümünü denetlediği java'nın yolunu yazar, sonra
#   systemctl --user daemon-reload
#   systemctl --user enable --now agentkb
# çalıştırır. Oturum açılmadan da çalışsın istiyorsan: loginctl enable-linger "$USER"

[Unit]
Description=agentkb — AI ajanları için bilgi bankası sunucusu
After=default.target

[Service]
Type=simple
ExecStart=@JAVA@ -Xms128m -Xmx512m -XX:+UseG1GC -XX:+ExitOnOutOfMemoryError -jar %h/kb-tools/agentkb-server.jar
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
UMask=0077

[Install]
WantedBy=default.target
