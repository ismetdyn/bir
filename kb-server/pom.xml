<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.ismetdyn</groupId>
    <artifactId>agentkb-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>kb-server</artifactId>

  <dependencies>
    <dependency>
      <groupId>io.github.ismetdyn</groupId>
      <artifactId>kb-api</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.github.ismetdyn</groupId>
      <artifactId>kb-core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.ai</groupId>
      <artifactId>spring-ai-starter-mcp-server-webmvc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.neo4j</groupId>
      <artifactId>neo4j</artifactId>
      <version>${neo4j.version}</version>
      <exclusions>
        <!-- Second SLF4J provider; Boot then fails: "LoggerFactory is not a Logback LoggerContext". -->
        <exclusion>
          <groupId>org.neo4j</groupId>
          <artifactId>neo4j-slf4j-provider</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <!-- schema/*.yaml and eval/questions.yaml; version from the Boot BOM (jackson-bom). -->
    <dependency>
      <groupId>tools.jackson.dataformat</groupId>
      <artifactId>jackson-dataformat-yaml</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <version>${archunit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>agentkb-server</finalName>
    <plugins>
      <!-- kb_schema shows the example queries of docs/MCP-TOOLS.md; the document stays their one place. -->
      <plugin>
        <artifactId>maven-resources-plugin</artifactId>
        <executions>
          <execution>
            <id>copy-mcp-tools-doc</id>
            <phase>process-resources</phase>
            <goals>
              <goal>copy-resources</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.outputDirectory}/docs</outputDirectory>
              <resources>
                <resource>
                  <directory>${project.basedir}/../docs</directory>
                  <includes>
                    <include>MCP-TOOLS.md</include>
                  </includes>
                </resource>
              </resources>
            </configuration>
          </execution>
          <!-- init writes seed/schema into a new ~/kb (InitCommand); seed/ stays their one place. -->
          <execution>
            <id>copy-seed-schema</id>
            <phase>process-resources</phase>
            <goals>
              <goal>copy-resources</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.outputDirectory}/seed/schema</outputDirectory>
              <resources>
                <resource>
                  <directory>${project.basedir}/../seed/schema</directory>
                  <includes>
                    <include>*.yaml</include>
                  </includes>
                </resource>
              </resources>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
      <!-- Runs *IT classes (SecretLeakIT, plan.md CP4) in verify; version and goals come from the Boot parent. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
