<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.ismetdyn</groupId>
    <artifactId>agentkb-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <!-- The kb command (docs/CLIENTS.md). F2: a JVM jar; native-image and TUI come in F3 (ADR-0022 decision 1). -->
  <artifactId>kb-client</artifactId>

  <dependencies>
    <!-- plan.md "Yeni bağımlılıklar": approved for G8; 4.7.7 is the latest release on Maven Central (2026-11-05). -->
    <dependency>
      <groupId>info.picocli</groupId>
      <artifactId>picocli</artifactId>
      <version>4.7.7</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- install.sh runs this jar as `java -jar`: the plugin kb-server already uses makes it self-contained
           (picocli inside, Main-Class set). No Spring code is added; the jar only gets the Boot launcher. -->
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <mainClass>io.github.ismetdyn.agentkb.client.Kb</mainClass>
        </configuration>
      </plugin>
      <!-- Runs *IT classes (KbJarIT: the packaged jar) in verify; version and goals come from the Boot parent. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
